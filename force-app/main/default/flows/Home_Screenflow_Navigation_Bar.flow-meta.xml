    <decisions>
        <description>Checks which button was pressed</description>
        <name>Which_Button_was_selected</name>
        <label>Which Button was selected</label>
        <locationX>710</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Quick_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FlowButtonBar.value</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quick Quote</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Quick_Quote</targetReference>
            </connector>
            <label>Quick Quote</label>
        </rules>
        <rules>
            <name>Booking_Form</name>
