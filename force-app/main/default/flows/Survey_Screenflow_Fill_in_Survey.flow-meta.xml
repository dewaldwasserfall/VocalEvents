    <decisions>
        <description>Checks if the loop counter is reached</description>
        <name>Is_Loop_counter_Reached</name>
        <label>Is Loop counter Reached ?</label>
        <locationX>578</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Assign_Response_Values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not reached</defaultConnectorLabel>
        <rules>
            <name>Loop_counter_reached</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLoopCounter</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>9.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Responses</targetReference>
            </connector>
            <label>Loop counter reached</label>
        </rules>
    </decisions>
    <description>A screenflow that lets the portal user fill in a survey</description>
    <environments>Default</environments>
    <formulas>
        <name>fmAnswer</name>
        <dataType>String</dataType>
        <expression>CASE({!varLoopCounter},
1,{!Q1},
2,{!Q2},
3,{!Q3},
4,{!Q4},
5,{!Q5},
6,{!Q6},
7,{!Q7},
8,{!Q8},
&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>fmNotes</name>
        <dataType>String</dataType>
        <expression>CASE({!varLoopCounter},
1,{!Notes_1},
2,{!Notes_2},
3,{!Notes_3},
4,{!Notes_4},
5,{!Notes_5},
6,{!Notes_6},
7,{!Notes_7},
8,{!Notes_8},
9,{!Q9},
&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>fmQuestionName</name>
        <dataType>String</dataType>
        <expression>CASE({!varLoopCounter},
1,&apos;How would you rate the service you received from our Vocal Events representative?&apos;,
2,&apos;How would you rate the artist(s) that performed at your function in terms of talent and professionalism?&apos;,
3,&apos;How would you rate the sound and lights provided, and was it sufficient for your function?&apos;,
4,&apos;How would you rate the artist’s crew members in terms of professionalism and support?&apos;,
5,&apos;Did the artist(s) meet or exceed your expectations for the event?&apos;,
6,&apos;How was your overall experience with Vocal Events?&apos;,
7,&apos;Was the booking process straightforward and convenient?&apos;,
8,&apos;Would you recommend Vocal Events to others?&apos;,
9,&apos;Do you have any feedback or comments that could help us improve?&apos;,
&apos;&apos;)</expression>
    </formulas>
