<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Updates the Venue&apos;s Town</description>
        <name>Update_Town</name>
        <label>Update Town</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.Town__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Town.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Checks if a town record was found</description>
        <name>Was_Town_Found</name>
        <label>Was Town Found</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Town</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Town</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>If the Address of the venue is known, the town is updated to match</description>
    <environments>Default</environments>
    <interviewLabel>Venue - RT - Update Town {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Venue - RT - Update Town</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the Town record that matches the City</description>
        <name>Get_Town</name>
        <label>Get Town</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_Town_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Address__City__s</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Town__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Town</targetReference>
        </connector>
        <filterFormula>{!$Record.Address__City__s}!={!$Record.Town__r.Name}&amp;&amp;
OR(
AND(ISNEW(),NOT(ISBLANK({!$Record.Address__City__s}))),
AND(ISCHANGED({!$Record.Address__City__s}),NOT(ISBLANK({!$Record.Address__City__s})))
)</filterFormula>
        <object>Venue__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>500</triggerOrder>
</Flow>
