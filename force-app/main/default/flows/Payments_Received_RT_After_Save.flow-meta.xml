<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Count_balances</name>
        <label>Count balances</label>
        <locationX>270</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>varBalancesPaid</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_balances.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBalanceDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fmBalanceDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_balances</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks if the related invoice has been paid in full</description>
        <name>Is_Invoice_Paid_in_Full</name>
        <label>Is Invoice Paid in Full ?</label>
        <locationX>182</locationX>
        <locationY>731</locationY>
        <defaultConnectorLabel>Outstanding</defaultConnectorLabel>
        <rules>
            <name>Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fmOutstandingBalance</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Balance_Paid_Date_on_Invoice</targetReference>
            </connector>
            <label>Paid</label>
        </rules>
    </decisions>
    <description>All automations that trigger after a Balance payment is received</description>
    <environments>Default</environments>
    <formulas>
        <name>fmBalanceDate</name>
        <dataType>Date</dataType>
        <expression>IF(
OR({!varBalanceDate}&lt;{!Loop_through_balances.Payment_Date__c},ISBLANK({!varBalanceDate})),{!Loop_through_balances.Payment_Date__c},{!varBalanceDate})</expression>
    </formulas>
    <formulas>
        <name>fmOutstandingBalance</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Invoice__r.Total_Incl_VAT__c}-{!$Record.Invoice__r.Deposits_Received__c}-{!varBalancesPaid}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Payments Received - RT - After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Payments Received - RT - After Save</label>
    <loops>
        <description>Loops through the balance payments</description>
        <name>Loop_through_balances</name>
        <label>Loop through balances</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <collectionReference>Get_all_balance_payments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Count_balances</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Is_Invoice_Paid_in_Full</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets all the balance payments to determine the latest payment date</description>
        <name>Get_all_balance_payments</name>
        <label>Get all balance payments</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_balances</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Balance</stringValue>
            </value>
        </filters>
        <filters>
            <field>Invoice__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Invoice__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Payments_Received__c</object>
        <sortField>Payment_Date__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Sets the balance paid date on the invoice</description>
        <name>Update_Balance_Paid_Date_on_Invoice</name>
        <label>Update Balance Paid Date on Invoice</label>
        <locationX>50</locationX>
        <locationY>839</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Invoice__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Balance_Paid__c</field>
            <value>
                <elementReference>varBalanceDate</elementReference>
            </value>
        </inputAssignments>
        <object>Invoice__c</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_all_balance_payments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Balance</stringValue>
            </value>
        </filters>
        <object>Payments_Received__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varBalanceDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varBalancesPaid</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
