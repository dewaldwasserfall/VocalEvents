                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_over_Town_Distances.Destination__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_varBookingRelation</targetReference>
            </connector>
            <label>Town Match</label>
        </rules>
