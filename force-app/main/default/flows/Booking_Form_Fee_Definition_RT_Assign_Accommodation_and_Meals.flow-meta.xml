<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When a Booking Form Fee Definition is created, this flow assigns the Accommodation and Meals for the Booking Form</description>
    <environments>Default</environments>
    <interviewLabel>Booking Form Fee Definition - RT - Assign Accommodation and Meals {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Booking Form Fee Definition - RT - Assign Accommodation and Meals</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the Booking Fee Definition for this Booking Form with the Highest number of Accommodation and Meals</description>
        <name>Get_Booking_Fee_Definitions</name>
        <label>Get Booking Fee Definitions</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Booking_Form_Accommodation_and_meals</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Booking_Form__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Booking_Form__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Booking_Form_Fee_Definition__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Accommodation_and_Meals__c</queriedFields>
        <sortField>Accommodation_and_Meals__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the Accommodation and meals on the booking form</description>
        <name>Update_Booking_Form_Accommodation_and_meals</name>
        <label>Update Booking Form Accommodation and meals</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Booking_Form__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Accommodation_and_Meals__c</field>
            <value>
                <elementReference>$Record.Accommodation_and_Meals__c</elementReference>
            </value>
        </inputAssignments>
        <object>Booking_Form__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Booking_Fee_Definitions</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.Booking_Form__c}))&amp;&amp;
NOT(ISBLANK({!$Record.Artist_Fee_Definition__c}))&amp;&amp;
NOT(ISBLANK({!$Record.Artist_Fee_Definition__r.Accommodation_and_Meals__c}))</filterFormula>
        <object>Booking_Form_Fee_Definition__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
