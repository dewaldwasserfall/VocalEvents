    <recordLookups>
        <description>Gets Town Distance Records with no Distance in Km</description>
        <name>Get_Town_Distances</name>
        <label>Get Town Distances</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Were_records_found</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND 3 AND 4 AND 5</filterLogic>
        <filters>
            <field>Driving_Distance_Km__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Driving_Distance_Km__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Start_End__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Destination_Province__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Outside of South Africa</stringValue>
            </value>
        </filters>
        <filters>
            <field>Starting_Town_Province__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Outside of South Africa</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>
            <numberValue>100.0</numberValue>
        </limit>
        <object>Town_Distance__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
