<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>A flow that calculates the Driving Distance on Update</description>
    <environments>Default</environments>
    <formulas>
        <name>F_Destination</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Destination__r.Geolocation__Latitude__s})&amp;&quot;,&quot;&amp;TEXT({!$Record.Destination__r.Geolocation__Longitude__s})</expression>
    </formulas>
    <formulas>
        <name>F_Origin</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Starting_Town__r.Geolocation__Latitude__s})&amp;&quot;,&quot;&amp;TEXT({!$Record.Starting_Town__r.Geolocation__Longitude__s})</expression>
    </formulas>
    <interviewLabel>Town Distance - RT - Update Driving Distance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Town Distance - RT - Update Driving Distance</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updates the driving distance field</description>
        <name>Update_Driving_Distance</name>
        <label>Update Driving Distance</label>
        <locationX>308</locationX>
        <locationY>384</locationY>
        <inputAssignments>
            <field>Driving_Distance_Km__c</field>
            <value>
                <elementReference>Get_Distance_and_Duration.OUT_Distance_in_KM</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Duration__c</field>
            <value>
                <elementReference>Get_Distance_and_Duration.OUT_Duration_Parsed</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UpdateDateTime__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Town_Distance__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Distance_and_Duration</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Get_Distance_and_Duration</name>
        <label>Get Distance and Duration</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <connector>
            <targetReference>Update_Driving_Distance</targetReference>
        </connector>
        <flowName>Town_Distance_Subflow_Get_Driving_Distnce</flowName>
        <inputAssignments>
            <name>destination</name>
            <value>
                <elementReference>F_Destination</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>origin</name>
            <value>
                <elementReference>F_Origin</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>varDestLat</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>6</scale>
    </variables>
    <variables>
        <name>varDestLong</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>6</scale>
    </variables>
    <variables>
        <name>varDistance</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varStartingLat</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>6</scale>
    </variables>
    <variables>
        <name>varStartingLong</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>6</scale>
    </variables>
</Flow>
