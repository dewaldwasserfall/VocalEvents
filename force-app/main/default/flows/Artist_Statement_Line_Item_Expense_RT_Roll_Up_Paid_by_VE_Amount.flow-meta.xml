<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds to the value of total Expenses</description>
        <name>Add_to_total_Expenses</name>
        <label>Add to total Expenses</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varExpenses</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_over_Expenses.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_over_Expenses</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks if Expenses were found</description>
        <name>Were_Expenses_Found</name>
        <label>Were Expenses Found ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Line_Item_Expenses</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Expenses Found</defaultConnectorLabel>
        <rules>
            <name>Expenses_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_VE_Expenses</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_over_Expenses</targetReference>
            </connector>
            <label>Expenses Found</label>
        </rules>
    </decisions>
    <description>Rolls up the total Expenses Paid by Vocal Events</description>
    <environments>Default</environments>
    <interviewLabel>Artist Statement Line Item Expense - RT - Roll Up Paid by VE Amount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Artist Statement Line Item Expense - RT - Roll Up Paid by VE Amount</label>
    <loops>
        <description>Loops over the Expenses</description>
        <name>Loop_over_Expenses</name>
        <label>Loop over Expenses</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_VE_Expenses</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_to_total_Expenses</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Line_Item_Expenses</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets all the Expenses Paid by VE for this Line Item</description>
        <name>Get_VE_Expenses</name>
        <label>Get VE Expenses</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Were_Expenses_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Artist_Statement_Line_Item__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Artist_Statement_Line_Item__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Paid_by_VE__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Artist_Statement_Line_Item_Expense__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the Total Paid by VE for this Line Item</description>
        <name>Update_Line_Item_Expenses</name>
        <label>Update Line Item Expenses</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Artist_Statement_Line_Item__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Expenses_Paid_by_VE__c</field>
            <value>
                <elementReference>varExpenses</elementReference>
            </value>
        </inputAssignments>
        <object>Artist_Statement_Line_Item__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_VE_Expenses</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.Paid_by_VE__c}))</filterFormula>
        <object>Artist_Statement_Line_Item_Expense__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varExpenses</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
