    <decisions>
        <description>Checks if the user is done editing, because it is boring and tedious</description>
        <name>Check_if_done_editing</name>
        <label>Check if done editing</label>
        <locationX>396</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>Loop_over_Venues</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not done</defaultConnectorLabel>
        <rules>
            <name>Done</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Done_Editing</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Update_venues</targetReference>
            </connector>
            <label>Done</label>
        </rules>
    </decisions>
