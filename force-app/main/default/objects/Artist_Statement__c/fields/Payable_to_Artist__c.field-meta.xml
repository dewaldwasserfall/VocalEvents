<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payable_to_Artist__c</fullName>
    <formula>Subtotal__c 
	+ Total_Travel_Fees__c 
	+ Total_Expenses__c 
	-  Total_Expenses_Paid_by_VE__c 
	+ IF(Artist__r.Name = &apos;FATMAN&apos;,Total_Technical_Fees__c,0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Payable to Artist</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
