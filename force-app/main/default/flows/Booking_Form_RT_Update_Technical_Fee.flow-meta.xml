            <assignToReference>varFeeDefinition.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_over_Fee_Definitions.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colFeeDefinitions</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varFeeDefinition</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_over_Fee_Definitions</targetReference>
