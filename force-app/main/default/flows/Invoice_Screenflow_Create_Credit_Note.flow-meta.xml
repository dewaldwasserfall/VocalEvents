    <description>Creates a Credit Note from an Invoice</description>
    <environments>Default</environments>
    <formulas>
        <name>fmCreditNoteName</name>
        <dataType>String</dataType>
        <expression>&quot;Credit Note : &quot;&amp;{!recordId.Name}</expression>
    </formulas>
    <formulas>
        <name>fmCreditNoteNumber</name>
        <dataType>String</dataType>
        <expression>{!recordId.Invoice_From_Account__r.Credit_Note_Prefix__c}&amp;
CASE(
   LEN(TEXT({!recordId.Invoice_From_Account__r.Next_Credit_Note_Number__c})),
   1, &quot;00000&quot; &amp; TEXT({!recordId.Invoice_From_Account__r.Next_Credit_Note_Number__c}),
   2, &quot;0000&quot; &amp; TEXT({!recordId.Invoice_From_Account__r.Next_Credit_Note_Number__c}),
   3, &quot;000&quot; &amp; TEXT({!recordId.Invoice_From_Account__r.Next_Credit_Note_Number__c}),
   4, &quot;00&quot; &amp; TEXT({!recordId.Invoice_From_Account__r.Next_Credit_Note_Number__c}),
   5, &quot;0&quot; &amp; TEXT({!recordId.Invoice_From_Account__r.Next_Credit_Note_Number__c}),
  TEXT({!recordId.Invoice_From_Account__r.Next_Credit_Note_Number__c}))</expression>
    </formulas>
