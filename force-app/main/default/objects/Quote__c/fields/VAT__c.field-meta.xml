<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VAT__c</fullName>
    <description>The percentage charged as VAT</description>
    <formula>IF(CreatedDate &lt; DATETIMEVALUE(DATE(2025, 5, 1)),
$Setup.VocalEventsSettings__c.VAT__c,
$Setup.VocalEventsSettings__c.VAT_Post_May_2025__c )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>VAT %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
