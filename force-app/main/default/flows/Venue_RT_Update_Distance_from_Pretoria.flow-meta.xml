<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets the Distance from Pretoria to 0</description>
        <name>Set_Distance_to_0</name>
        <label>Set Distance to 0</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Distance_from_Pretoria_Km__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Update_Distance_from_Pretoria</name>
        <label>Update Distance from Pretoria</label>
        <locationX>314</locationX>
        <locationY>611</locationY>
        <assignmentItems>
            <assignToReference>$Record.Distance_from_Pretoria_Km__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Town_Distance_Record.Driving_Distance_Km__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Checks if the venue is in Pretoria</description>
        <name>Is_Venue_in_Pretoria</name>
        <label>Is Venue in Pretoria ?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Get_Pretoria_Town_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not in Pretoria</defaultConnectorLabel>
        <rules>
            <name>Venue_is_in_Pretoria</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Town__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pretoria</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Distance_to_0</targetReference>
            </connector>
            <label>Venue is in Pretoria</label>
        </rules>
    </decisions>
    <description>Updates the Distance between Pretoria and this venue</description>
    <environments>Default</environments>
    <interviewLabel>Venue - RT - Update Distance from Pretoria {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Venue - RT - Update Distance from Pretoria</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Pretoria_Town_Record</name>
        <label>Get Pretoria Town Record</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Town_Distance_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pretoria</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Town__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the correct Town Distance record</description>
        <name>Get_Town_Distance_Record</name>
        <label>Get Town Distance Record</label>
        <locationX>314</locationX>
        <locationY>503</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Distance_from_Pretoria</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Starting_Town__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Town__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Destination__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Pretoria_Town_Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Town_Distance__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Venue_in_Pretoria</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.UpdateDateTime__c}) ||
OR(
  AND(ISNEW(), NOT(ISBLANK({!$Record.Town__c}))),
  AND(ISCHANGED({!$Record.Town__c}), NOT(ISBLANK({!$Record.Town__c})))
)</filterFormula>
        <object>Venue__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
