    <description>Updates the Quote Totals if a Line Item is edited</description>
    <environments>Default</environments>
    <formulas>
        <name>fmDiscountedFee</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Price_per_unit__c}-({!$Record.Price_per_unit__c}*({!$Record.Quote__r.Discount__c}/100))*{!$Record.Quantity__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fmLineItemFee</name>
        <dataType>Currency</dataType>
        <expression>IF({!$Record.Include_in_discount__c}==true,
{!fmDiscountedFee},({!$Record.Price_per_unit__c}*{!$Record.Quantity__c}))</expression>
        <scale>2</scale>
    </formulas>
