                </rightValue>
            </conditions>
            <connector>
                <targetReference>Quick_Create_Booking_Form</targetReference>
            </connector>
            <label>Booking Form</label>
        </rules>
        <rules>
            <name>Generic_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FlowButtonBar.value</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Generic Quote</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Generic_Quote</targetReference>
            </connector>
            <label>Generic Quote</label>
        </rules>
        <rules>
            <name>Generic_Invoice</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FlowButtonBar.value</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Generic Invoice</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Generic_Invoice</targetReference>
            </connector>
            <label>Generic Invoice</label>
        </rules>
        <rules>
            <name>Send_Promotional_Material</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FlowButtonBar.value</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Send Promotional Material</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Promotional_Materials</targetReference>
            </connector>
            <label>Send Promotional Material</label>
        </rules>
    </decisions>
