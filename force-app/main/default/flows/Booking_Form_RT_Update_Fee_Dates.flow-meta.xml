<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assigns the new date</description>
        <name>Assign_new_date</name>
        <label>Assign new date</label>
        <locationX>138</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>varBookingFeeDefinition.Booking_Form__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBookingFeeDefinition.Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fmNewDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBookingFeeDefinition.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_over_fee_definitions.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBookingFeeDefinition.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fmNewName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colBookingFeeDefinitions</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varBookingFeeDefinition</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_over_fee_definitions</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks if any fees were found</description>
        <name>Were_fees_found</name>
        <label>Were fees found</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Update_End_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Booking_Fee_Definitions</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_over_fee_definitions</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>Update the booking form fee definition dates when the date of performance is changed</description>
    <environments>Default</environments>
    <formulas>
        <name>fmNewDate</name>
        <dataType>Date</dataType>
        <expression>{!Loop_over_fee_definitions.Date__c}+({!$Record.Date_of_Performance__c}-{!$Record__Prior.Date_of_Performance__c})</expression>
    </formulas>
    <formulas>
        <name>fmNewEndDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.End_Date__c}+({!$Record.Date_of_Performance__c}-{!$Record__Prior.Date_of_Performance__c})</expression>
    </formulas>
    <formulas>
        <name>fmNewName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Artist__r.Name}&amp;&quot; - &quot;&amp;{!$Record.Town_or_City__r.Name}&amp;&quot; - &quot;&amp;TEXT({!varBookingFeeDefinition.Date__c})</expression>
    </formulas>
    <interviewLabel>Booking Form - RT - Update Fee Dates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Booking Form - RT - Update Fee Dates</label>
    <loops>
        <description>Loops over the fee definitions</description>
        <name>Loop_over_fee_definitions</name>
        <label>Loop over fee definitions</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <collectionReference>Get_Booking_Fee_Definitions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_new_date</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Booking_Fee_Dates</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets all related booking fee definitions</description>
        <name>Get_Booking_Fee_Definitions</name>
        <label>Get Booking Fee Definitions</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Were_fees_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Booking_Form__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Booking_Form_Fee_Definition__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the dates of the Booking form fee definitions</description>
        <name>Update_Booking_Fee_Dates</name>
        <label>Update Booking Fee Dates</label>
        <locationX>50</locationX>
        <locationY>839</locationY>
        <connector>
            <targetReference>Update_End_Date</targetReference>
        </connector>
        <inputReference>colBookingFeeDefinitions</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Updates the End Date of the Performance</description>
        <name>Update_End_Date</name>
        <label>Update End Date</label>
        <locationX>182</locationX>
        <locationY>1031</locationY>
        <inputAssignments>
            <field>End_Date__c</field>
            <value>
                <elementReference>fmNewEndDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Booking_Fee_Definitions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Date_of_Performance__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Date_of_Performance__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Booking_Form__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>colBookingFeeDefinitions</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Booking_Form_Fee_Definition__c</objectType>
    </variables>
    <variables>
        <name>varBookingFeeDefinition</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Booking_Form_Fee_Definition__c</objectType>
    </variables>
</Flow>
