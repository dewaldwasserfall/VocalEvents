<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VAT_Amount__c</fullName>
    <description>The Amount of VAT Charged for the Line Item</description>
    <formula>IF(Includes_VAT__c, ((Performance_Fee__c + Travel_Fee__c)*  $Setup.VocalEventsSettings__c.VAT__c),0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>VAT Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
