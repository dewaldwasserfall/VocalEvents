<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Fee__c</fullName>
    <description>This is checked if this fee is currently active</description>
    <formula>IF(TODAY()&gt;Fee_Start_Date__c &amp;&amp;
			OR(TODAY()&lt; Fee_End_Date__c,ISBLANK(Fee_End_Date__c)),
				True,False)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Active Fee</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
