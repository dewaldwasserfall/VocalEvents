<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>The Field to include technical in Deposit is set as the inverse value of Artist.Technical_is_invoiced_seperately</description>
        <name>Set_Include_Technical_in_Deposit_Field</name>
        <label>Set Include Technical in Deposit Field</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Include_Technical_Fee_in_Deposit__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fmIncludeTechnicalFee</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>When a booking form is created, this flow defaults the &quot;Include Technical in Deposit&quot; field</description>
    <environments>Default</environments>
    <formulas>
        <name>fmIncludeTechnicalFee</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.Artist__r.Technical_is_invoiced_separately__c},False,True)</expression>
    </formulas>
    <interviewLabel>Booking Form - RT - Set Include Technical in Deposit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Booking Form - RT - Set Include Technical in Deposit</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Include_Technical_in_Deposit_Field</targetReference>
        </connector>
        <filterFormula>{!$Record.Include_Technical_Fee_in_Deposit__c}={!$Record.Artist__r.Technical_is_invoiced_separately__c}</filterFormula>
        <object>Booking_Form__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
