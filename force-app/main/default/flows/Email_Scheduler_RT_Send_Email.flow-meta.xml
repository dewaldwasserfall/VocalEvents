    <decisions>
        <description>Checks if the scheduler is active</description>
        <name>Is_Scheduler_Active</name>
        <label>Is Scheduler Active ?</label>
        <locationX>374</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Inactive</defaultConnectorLabel>
        <rules>
            <name>Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Organisation</targetReference>
            </connector>
            <label>Active</label>
        </rules>
    </decisions>
    <description>A flow that sends emails out on schedule</description>
    <environments>Default</environments>
    <formulas>
        <name>fmBaseURL</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Organisation.IsSandbox},&apos;https://vocalevents--uat.sandbox.my.site.com&apos;,&apos;	https://vocalevents.my.site.com&apos;)</expression>
    </formulas>
    <formulas>
        <name>fmLinkURL</name>
        <dataType>String</dataType>
        <expression>{!fmBaseURL}&amp;&apos;/portal/s/survey?varBookingForm=&apos;&amp;{!$Record.Booking_Form__c}</expression>
    </formulas>
    <interviewLabel>Email Scheduler - RT - Send Email {!$Flow.CurrentDateTime}</interviewLabel>
