<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VAT_on_Performance_and_Travel_Fee__c</fullName>
    <formula>IF( VAT_Applicable__c,
(Artist_Travel_Costs__c + Performance_Fee__c )*  $Setup.VocalEventsSettings__c.VAT__c,0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>The VAT charged for the Performance and Travel</inlineHelpText>
    <label>VAT on Performance and Travel Fee</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
