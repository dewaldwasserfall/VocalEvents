<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Updates the trip duration</description>
        <name>Update_Duration</name>
        <label>Update Duration</label>
        <locationX>50</locationX>
        <locationY>719</locationY>
        <assignmentItems>
            <assignToReference>$Record.Trip_Duration__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Distance_Record.Duration__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Updates the travelling distance based on the existing Town Distance record</description>
        <name>Update_Travelling_Distance</name>
        <label>Update Travelling Distance</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.Travelling_Distance__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fmTravelDistance</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Artist_travelling_by_Road</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks if there is an existing Town Distance record for this combination</description>
        <name>Does_Distance_Record_Exist</name>
        <label>Does Distance Record Exist</label>
        <locationX>336</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Distance_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Distance_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Travelling_Distance</targetReference>
            </connector>
            <label>Distance Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if the Artist is travelling by Road</description>
        <name>Is_Artist_travelling_by_Road</name>
        <label>Is Artist travelling by Road</label>
        <locationX>182</locationX>
        <locationY>611</locationY>
        <defaultConnectorLabel>Air</defaultConnectorLabel>
        <rules>
            <name>Road</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Travelling_By__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Road</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Duration</targetReference>
            </connector>
            <label>Road</label>
        </rules>
    </decisions>
    <description>Updates the Travel Distance when a booking form is Created or Updated</description>
    <environments>Default</environments>
    <formulas>
        <name>fmTravelDistance</name>
        <dataType>Number</dataType>
        <expression>ROUND({!Get_Distance_Record.Driving_Distance_Km__c},0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Booking Form - RT - Update Travel Distance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Booking Form - RT - Update Travel Distance</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the Town Distance record for this Booking</description>
        <name>Get_Distance_Record</name>
        <label>Get Distance Record</label>
        <locationX>336</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_Distance_Record_Exist</targetReference>
        </connector>
        <filterLogic>(1 AND 2) OR (3 AND 4)</filterLogic>
        <filters>
            <field>Starting_Town__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Travelling_From__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Destination__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Town_or_City__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Starting_Town__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Town_or_City__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Destination__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Travelling_From__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Town_Distance__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>210</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Distance_Record</targetReference>
        </connector>
        <filterFormula>AND(ISNEW(),NOT(ISBLANK({!$Record.Travelling_From__c})),NOT(ISBLANK({!$Record.Town_or_City__c})))
||
NOT(ISBLANK({!$Record.Travelling_From__c}))&amp;&amp;
NOT(ISBLANK({!$Record.Town_or_City__c}))&amp;&amp;
OR(ISCHANGED({!$Record.Travelling_From__c}),ISCHANGED({!$Record.Town_or_City__c}))</filterFormula>
        <object>Booking_Form__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>1200</triggerOrder>
</Flow>
