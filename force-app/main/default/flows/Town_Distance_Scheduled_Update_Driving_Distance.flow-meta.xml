    <decisions>
        <description>Checks if records were found</description>
        <name>Were_records_found</name>
        <label>Were records found ?</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>Records_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Town_Distances</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_over_remaining_records</targetReference>
            </connector>
            <label>Records found</label>
        </rules>
    </decisions>
    <description>Runs daily to update driving distance in km in batches of 100</description>
    <environments>Default</environments>
    <interviewLabel>Town Distance - Scheduled - Update Driving Distance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Town Distance - Scheduled - Update Driving Distance</label>
    <loops>
        <description>Loops over the remaining records</description>
        <name>Loop_over_remaining_records</name>
        <label>Loop over remaining records</label>
        <locationX>50</locationX>
        <locationY>468</locationY>
        <collectionReference>Get_Town_Distances</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Update_DateTime</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_remaining_records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
