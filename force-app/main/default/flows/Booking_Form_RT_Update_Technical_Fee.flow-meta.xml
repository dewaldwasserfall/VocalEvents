    </assignments>
    <decisions>
        <description>Checks if Fee Definitions were found</description>
        <name>Were_fee_definitions_found</name>
        <label>Were fee definitions found</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Fee_Definitions</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_over_Fee_Definitions</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Who_is_Sound_Supplied_By</name>
        <label>Who is Sound Supplied By</label>
        <locationX>270</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Update_Technical_Fee</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Artist</defaultConnectorLabel>
        <rules>
            <name>Client</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Sound_supplied_by__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Kliënt</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Technical_Fee</targetReference>
            </connector>
            <label>Client</label>
        </rules>
    </decisions>
    <description>When the field Sound Supplied By is changed, the Technical fee is updated</description>
    <environments>Default</environments>
    <formulas>
        <name>fmTechnicalFee</name>
        <dataType>Currency</dataType>
        <expression>IF(ISPICKVAL({!$Record.Amount_of_People__c},&apos;1 - 500&apos;),
{!Loop_over_Fee_Definitions.Artist_Fee_Definition__r.Technical_1_500_people__c},{!Loop_over_Fee_Definitions.Artist_Fee_Definition__r.Technical_501_1000_people__c})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Booking Form - RT - Update Technical Fee {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Booking Form - RT - Update Technical Fee</label>
    <loops>
