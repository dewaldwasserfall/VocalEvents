    <description>A screenflow that lets agents create an Artist Statement</description>
    <environments>Default</environments>
    <formulas>
        <name>fmArtistExpenseName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Loop_over_selected_bookings.Description_of_Artist_Expenses__c}),&apos;Vaste Uitgawe&apos;,{!Loop_over_selected_bookings.Description_of_Artist_Expenses__c})</expression>
    </formulas>
    <formulas>
        <name>fmEndDate</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate}),MONTH({!$Flow.CurrentDate}),
CASE(MONTH({!$Flow.CurrentDate}),
1,31,
2,28,
3,31,
4,30,
5,31,
6,30,
7,31,
8,31,
9,30,
10,31,
11,30,
31)
)</expression>
    </formulas>
    <formulas>
        <name>fmLineItemName</name>
        <dataType>String</dataType>
        <expression>{!Loop_over_selected_bookings.Town_or_City__r.Name}&amp;&quot; - &quot;&amp;TEXT({!Loop_over_selected_bookings.Date_of_Performance__c})</expression>
    </formulas>
    <formulas>
        <name>fmStartDate</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate}),MONTH({!$Flow.CurrentDate}),1)</expression>
    </formulas>
    <formulas>
        <name>fmStatementName</name>
        <dataType>String</dataType>
        <expression>{!varStatement.Artist__r.Name}&amp;&quot; - &quot;&amp;TEXT({!Start_Date})&amp;&quot; to &quot;&amp;TEXT({!End_Date})</expression>
    </formulas>
    <formulas>
        <name>fmTechnicalFee</name>
        <dataType>Currency</dataType>
        <expression>IF({!varStatement.Artist__r.Name}=&apos;FATMAN&apos;,{!Loop_over_selected_bookings.Technical_fee__c},0)</expression>
        <scale>2</scale>
    </formulas>
