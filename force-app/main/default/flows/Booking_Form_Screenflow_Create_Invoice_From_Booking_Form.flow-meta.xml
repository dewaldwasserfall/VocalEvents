    <description>A screenflow that helps agents create invoices from Booking form values</description>
    <environments>Default</environments>
    <formulas>
        <name>fmInvoiceNumber</name>
        <dataType>String</dataType>
        <expression>{!varInvoice.Invoice_From_Account__r.Invoice_Prefix__c} &amp;
CASE(
   LEN(TEXT({!varInvoice.Invoice_From_Account__r.Next_Invoice_Number__c})),
   1, &quot;00000&quot; &amp; TEXT({!varInvoice.Invoice_From_Account__r.Next_Invoice_Number__c}),
   2, &quot;0000&quot; &amp; TEXT({!varInvoice.Invoice_From_Account__r.Next_Invoice_Number__c}),
   3, &quot;000&quot; &amp; TEXT({!varInvoice.Invoice_From_Account__r.Next_Invoice_Number__c}),
   4, &quot;00&quot; &amp; TEXT({!varInvoice.Invoice_From_Account__r.Next_Invoice_Number__c}),
   5, &quot;0&quot; &amp; TEXT({!varInvoice.Invoice_From_Account__r.Next_Invoice_Number__c}),
  TEXT({!varInvoice.Invoice_From_Account__r.Next_Invoice_Number__c}))</expression>
    </formulas>
    <formulas>
        <name>fmValidUntil</name>
        <dataType>Date</dataType>
        <expression>TODAY()+5</expression>
    </formulas>
