<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SameAirports__c</fullName>
    <description>This formula is true if the Outbound Landing airport is the same as the inbound departure airport</description>
    <formula>TEXT(Landing_at_Outbound__c) = TEXT(Departing_From_Inbound__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>SameAirports</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
